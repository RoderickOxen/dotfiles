{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@3.0.5/oh-my-opencode-slim.schema.json",
  "preset": "mixed",
  "disabled_agents": [],
  "multiplexer": {
    "type": "none"
  },
  "presets": {
    "mixed": {
      "orchestrator": {
        "model": "anthropic/claude-opus-5-5",
        "variant": "high",
        "skills": ["*"],
        "mcps": ["*", "!context7"]
      },
      "oracle": {
        "model": "anthropic/claude-opus-5-5",
        "variant": "xhigh",
        "skills": ["simplify"],
        "mcps": []
      },
      "council": {
        "model": "anthropic/claude-opus-5-5",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "explorer": {
        "model": "anthropic/claude-haiku-5-5",
        "variant": "medium",
        "skills": [],
        "mcps": ["context7", "gh_grep"]
      },
      "designer": {
        "model": "openai/gpt-6.1-sol",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "anthropic/claude-sonnet-5-5",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "observer": {
        "model": "anthropic/claude-sonnet-5-5",
        "variant": "medium",
        "skills": [],
        "mcps": []
      }
    },
    "opencode-go": {
      "orchestrator": {
        "model": "opencode-go/minimax-m3",
        "variant": "thinking",
        "skills": ["*"],
        "mcps": ["*", "!context7"]
      },
      "oracle": {
        "model": "opencode-go/qwen3.7-max",
        "variant": "max",
        "skills": ["simplify"],
        "mcps": []
      },
      "explorer": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "high",
        "skills": [],
        "mcps": ["context7", "gh_grep"]
      },
      "designer": {
        "model": "opencode-go/kimi-k2.7-code",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "observer": {
        "model": "opencode-go/mimo-v2.5",
        "skills": [],
        "mcps": []
      }
    }
  },
  "council": {
    "default_preset": "balanced",
    "presets": {
      "balanced": {
        "alpha": {
          "model": "openai/gpt-6.1-sol",
          "variant": "high",
          "prompt": "Rigorous code-focused perspective. Prioritize implementation feasibility, edge cases, and concrete failure modes."
        },
        "beta": {
          "model": "anthropic/claude-sonnet-5-5",
          "variant": "high",
          "prompt": "Architectural perspective. Prioritize design coherence, module boundaries, and long-term maintainability."
        },
        "gamma": {
          "model": "google/gemini-4-argon",
          "variant": "high",
          "prompt": "Alternative perspective. Look for options the other councillors missed and challenge assumptions."
        }
      }
    }
  }
}
