{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",

  // Let DCP manage subagent sessions too (explore/librarian/oracle fan-out).
  // Default is false, which makes the hooks bail out early for subagents.
  "experimental": {
    "allowSubAgents": true
  }
}
