{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim@3.0.5"
  ],
  "instructions": [
    "cloudflare-cf-cli-instructions.md"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "git push *": "ask",
      "git checkout *": "ask"
    },
    "get-gmail-profile": "allow",
    "get-unread-emails": "allow",
    "global-search-emails": "allow",
    "list-gmail-labels": "allow",
    "summarize-top-k-emails": "allow",
    "vector-search-emails": "allow",
    "send-email": "ask",
    "delete-email": "ask",
    "delete-gmail-label": "ask",
    "create-label": "ask"
  },
  "mcp": {
    "excalidraw-cf": {
      "type": "remote",
      "url": "https://mcp.excalidraw.cfdata.org/mcp",
      "oauth": {},
      "enabled": true
    },
    "open-meteo": {
      "type": "local",
      "command": ["npx", "-y", "-p", "open-meteo-mcp-server", "open-meteo-mcp-server"]
    },
    "cf-portal": {
      "enabled": true
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    }
  }
}
